#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PREFIX_DIR="${PREFIX:-/data/data/com.termux/files/usr}"

if [ -n "${TERMUX_TTYD_PWA_DIR:-}" ]; then
  APP_DIR="$TERMUX_TTYD_PWA_DIR"
elif [ -d "$PREFIX_DIR/share/termux-ttyd-pwa/public" ]; then
  APP_DIR="$PREFIX_DIR/share/termux-ttyd-pwa"
else
  APP_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
fi

HOST="127.0.0.1"
APP_PORT="8080"
TTYD_PORT="7681"
FONT_FAMILY='"TermuxTtydPwaFont", monospace'
FONT_STYLE="termux"
COPY_TERMUX_FONT="yes"
ANDROID_FONT_FAMILY="monospace"
FONT_SIZE="14"
FONT_WEIGHT="normal"
LETTER_SPACING="0"
LINE_HEIGHT="1.2"
TERMINAL_PADDING="0"
TERMINAL_THEME='{"foreground":"#ffffff","background":"#000000","cursor":"#ffffff","cursorAccent":"#000000","selectionBackground":"#4d4d4d","black":"#000000","red":"#cc0000","green":"#00cc00","yellow":"#cccc00","blue":"#0000cc","magenta":"#cc00cc","cyan":"#00cccc","white":"#cccccc","brightBlack":"#666666","brightRed":"#ff0000","brightGreen":"#00ff00","brightYellow":"#ffff00","brightBlue":"#0000ff","brightMagenta":"#ff00ff","brightCyan":"#00ffff","brightWhite":"#ffffff"}'
CLIPBOARD_BRIDGE_HOST="${TERMUX_CLIPBOARD_BRIDGE_HOST:-127.0.0.1}"
CLIPBOARD_BRIDGE_PORT="${TERMUX_CLIPBOARD_BRIDGE_PORT:-8765}"
CLIPBOARD_BRIDGE="${TERMUX_TTYD_PWA_CLIPBOARD_BRIDGE:-yes}"
TMUX_SESSION=""
NATIVE_TMUX_SOCKET="termux-ttyd-pwa"
NATIVE_TMUX_CONF="${TERMUX_TTYD_PWA_NATIVE_TMUX_CONF:-${HOME:-/data/data/com.termux/files/home}/.tmux-pwa.conf}"
COMMAND=("${SHELL:-bash}")

usage() {
  printf 'Usage: %s [--host HOST] [--app-port PORT] [--ttyd-port PORT] [--clipboard-bridge yes|no] [--no-clipboard-bridge] [--tmux-session NAME] [--native-tmux-conf PATH] [--font-style termux] [--copy-termux-font yes|no] [--android-font-family FAMILY] [--font-size SIZE] [--font-weight WEIGHT] [--letter-spacing SPACING] [--line-height HEIGHT] [--terminal-padding CSS_LENGTH] [-- COMMAND...]\n' "$0"
}

font_family_for_style() {
  case "$1" in
    termux) printf '"TermuxTtydPwaFont", monospace' ;;
    *) return 1 ;;
  esac
}

require_value() {
  if [ "$#" -lt 2 ]; then
    printf '%s requires a value.\n' "$1" >&2
    exit 2
  fi
}

normalize_yes_no() {
  case "$2" in
    yes|true|1|on) printf 'yes' ;;
    no|false|0|off) printf 'no' ;;
    *)
      printf '%s must be yes or no.\n' "$1" >&2
      exit 2
      ;;
  esac
}

termux_theme() {
  python3 - "$TERMINAL_THEME" "${TERMUX_COLORS_FILE:-}" "${HOME:-}/.termux/colors.properties" "/data/data/com.termux/files/home/.termux/colors.properties" <<'PY'
import json
import os
import sys

theme = json.loads(sys.argv[1])
paths = [os.path.expanduser(path) for path in sys.argv[2:] if path]
path = next((candidate for candidate in paths if os.path.isfile(candidate)), None)

mapping = {
    "background": "background",
    "foreground": "foreground",
    "cursor": "cursor",
    "color0": "black",
    "color1": "red",
    "color2": "green",
    "color3": "yellow",
    "color4": "blue",
    "color5": "magenta",
    "color6": "cyan",
    "color7": "white",
    "color8": "brightBlack",
    "color9": "brightRed",
    "color10": "brightGreen",
    "color11": "brightYellow",
    "color12": "brightBlue",
    "color13": "brightMagenta",
    "color14": "brightCyan",
    "color15": "brightWhite",
}

if path:
    with open(path, encoding="utf-8") as file:
        for line in file:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = [part.strip() for part in line.split("=", 1)]
            if key in mapping and value:
                theme[mapping[key]] = value
    theme["cursorAccent"] = theme.get("background", "#000000")

print(json.dumps(theme, ensure_ascii=True, separators=(",", ":")))
PY
}

create_ttyd_index() {
  local output_path="$1"
  local font_path="$2"
  local clipboard_bridge_url="$3"
  local probe_port
  local probe_pid

  probe_port="$(python3 - <<'PY'
import socket

with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
    sock.bind(("127.0.0.1", 0))
    print(sock.getsockname()[1])
PY
)"

  ttyd --interface 127.0.0.1 --port "$probe_port" sh -c 'sleep 10' >/dev/null 2>&1 &
  probe_pid="$!"

  local status=0
  python3 - "$probe_port" "$output_path" "$font_path" "$clipboard_bridge_url" <<'PY' || status="$?"
import sys
import time
import urllib.request

port, output_path, font_path, clipboard_bridge_url = sys.argv[1:]
url = f"http://127.0.0.1:{port}/"
last_error = None

for _ in range(30):
    try:
        with urllib.request.urlopen(url, timeout=1) as response:
            html = response.read().decode("utf-8")
        break
    except Exception as error:
        last_error = error
        time.sleep(0.1)
else:
    raise SystemExit(f"Failed to read ttyd default index: {last_error}")

head_injections = []

if font_path:
    import base64

    with open(font_path, "rb") as file:
        font_data = base64.b64encode(file.read()).decode("ascii")

    head_injections.append(
        '<style id="termux-ttyd-pwa-font">'
        '@font-face{font-family:"TermuxTtydPwaFont";'
        f'src:url(data:font/ttf;base64,{font_data}) format("truetype");'
        'font-display:block;}'
        '</style>'
    )

head_injections.append(r'''<script id="termux-ttyd-pwa-shortcuts">
(function () {
  var clipboardBridgeUrl = __CLIPBOARD_BRIDGE_URL__;

  function isTerminalTextarea(target) {
    return target && target.classList && target.classList.contains("xterm-helper-textarea");
  }

  function isEditable(target) {
    if (!target || isTerminalTextarea(target)) return false;
    var name = target.tagName ? target.tagName.toLowerCase() : "";
    return target.isContentEditable || name === "input" || name === "textarea" || name === "select";
  }

  function clipboardEvent(text) {
    var clipboardData;
    try {
      clipboardData = new DataTransfer();
      clipboardData.setData("text/plain", text);
    } catch (error) {
      clipboardData = { getData: function (type) { return type === "text/plain" ? text : ""; } };
    }

    try {
      return new ClipboardEvent("paste", {
        bubbles: true,
        cancelable: true,
        clipboardData: clipboardData
      });
    } catch (error) {
      var event = new Event("paste", { bubbles: true, cancelable: true });
      Object.defineProperty(event, "clipboardData", { value: clipboardData });
      return event;
    }
  }

  function readBridgeClipboard() {
    if (!clipboardBridgeUrl) return Promise.resolve("");
    return fetch(clipboardBridgeUrl + "/get", { cache: "no-store" }).then(function (response) {
      return response.ok ? response.text() : "";
    }).catch(function () {
      return "";
    });
  }

  function readClipboardText() {
    if (!navigator.clipboard || !navigator.clipboard.readText) return readBridgeClipboard();
    return navigator.clipboard.readText().catch(readBridgeClipboard);
  }

  function pasteText(text) {
    if (!text) return;
    var textarea = document.querySelector(".xterm-helper-textarea");
    if (!textarea) return;
    textarea.focus();
    textarea.dispatchEvent(clipboardEvent(text));
  }

  document.addEventListener("keydown", function (event) {
    if (!event.ctrlKey || event.shiftKey || event.altKey || event.metaKey) return;
    if (String(event.key || "").toLowerCase() !== "v" && event.code !== "KeyV") return;
    if (isEditable(event.target)) return;

    event.preventDefault();
    event.stopPropagation();

    readClipboardText().then(pasteText);
  }, true);
})();
</script>'''.replace("__CLIPBOARD_BRIDGE_URL__", repr(clipboard_bridge_url)))

if "</head>" not in html:
    raise SystemExit("ttyd default index does not contain </head>")

with open(output_path, "w", encoding="utf-8") as file:
    file.write(html.replace("</head>", "".join(head_injections) + "</head>", 1))
PY

  kill "$probe_pid" 2>/dev/null || true
  wait "$probe_pid" 2>/dev/null || true
  return "$status"
}

termux_font_file() {
  local path
  for path in \
    "${TERMUX_FONT_FILE:-}" \
    "${HOME:-}/.termux/font.ttf" \
    "/data/data/com.termux/files/home/.termux/font.ttf"; do
    if [ -n "$path" ] && [ -f "$path" ]; then
      printf '%s\n' "$path"
      return 0
    fi
  done
  return 1
}

tcp_port_open() {
  python3 - "$1" "$2" <<'PY'
import socket
import sys

host, port = sys.argv[1], int(sys.argv[2])
with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
    sock.settimeout(0.3)
    raise SystemExit(0 if sock.connect_ex((host, port)) == 0 else 1)
PY
}

ensure_server_ports_available() {
  local app_port_open="no"
  local ttyd_port_open="no"

  if tcp_port_open "$HOST" "$APP_PORT"; then
    app_port_open="yes"
  fi
  if tcp_port_open "$HOST" "$TTYD_PORT"; then
    ttyd_port_open="yes"
  fi

  if [ "$app_port_open" = "yes" ] && [ "$ttyd_port_open" = "yes" ]; then
    printf 'termux-ttyd-pwa is already running:\n'
    printf 'ttyd: http://%s:%s/\n' "$HOST" "$TTYD_PORT"
    printf 'PWA:  http://%s:%s/\n' "$HOST" "$APP_PORT"
    exit 0
  fi

  if [ "$ttyd_port_open" = "yes" ]; then
    printf 'ttyd port is already in use: http://%s:%s/\n' "$HOST" "$TTYD_PORT" >&2
    printf 'Stop the existing process or start with --ttyd-port PORT.\n' >&2
    exit 1
  fi

  if [ "$app_port_open" = "yes" ]; then
    printf 'PWA port is already in use: http://%s:%s/\n' "$HOST" "$APP_PORT" >&2
    printf 'Stop the existing process or start with --app-port PORT.\n' >&2
    exit 1
  fi
}

start_clipboard_bridge() {
  local bridge_path="$APP_DIR/extras/termux-clipboard-bridge.py"

  if [ ! -f "$bridge_path" ]; then
    printf 'Clipboard bridge was not found at %s.\n' "$bridge_path" >&2
    exit 1
  fi

  if tcp_port_open "$CLIPBOARD_BRIDGE_HOST" "$CLIPBOARD_BRIDGE_PORT"; then
    printf 'Clipboard bridge: http://%s:%s/ (already running)\n' "$CLIPBOARD_BRIDGE_HOST" "$CLIPBOARD_BRIDGE_PORT"
    return 0
  fi

  TERMUX_CLIPBOARD_BRIDGE_HOST="$CLIPBOARD_BRIDGE_HOST" \
    TERMUX_CLIPBOARD_BRIDGE_PORT="$CLIPBOARD_BRIDGE_PORT" \
    python3 "$bridge_path" &
  CLIPBOARD_BRIDGE_PID="$!"

  sleep 0.2
  if ! kill -0 "$CLIPBOARD_BRIDGE_PID" 2>/dev/null; then
    wait "$CLIPBOARD_BRIDGE_PID" 2>/dev/null || true
    printf 'Failed to start clipboard bridge.\n' >&2
    exit 1
  fi
}

ensure_native_tmux_config() {
  local config_path="$1"
  local config_dir

  if [ -f "$config_path" ]; then
    return 0
  fi

  config_dir="${config_path%/*}"
  if [ "$config_dir" != "$config_path" ]; then
    mkdir -p "$config_dir"
  fi

  {
    printf '# Generated by termux-ttyd-pwa. Edit this file or pass --native-tmux-conf PATH.\n'
    printf 'if-shell '\''test -f "$HOME/.tmux.conf"'\'' '\''source-file ~/.tmux.conf'\''\n'
    printf '\n'
    printf 'set -g status off\n'
    printf 'set -g status-left ""\n'
    printf 'set -g status-right ""\n'
    printf 'set -g prefix None\n'
    printf 'set -g mouse off\n'
  } > "$config_path"
}

termux_font_defaults() {
  python3 - "$FONT_SIZE" "$FONT_WEIGHT" "$LETTER_SPACING" "$LINE_HEIGHT" "${TERMUX_PROPERTIES_FILE:-}" "${HOME:-}/.termux/termux.properties" "/data/data/com.termux/files/home/.termux/termux.properties" <<'PY'
import os
import shlex
import sys

font_size, font_weight, letter_spacing, line_height = sys.argv[1:5]
paths = [os.path.expanduser(path) for path in sys.argv[5:] if path]
path = next((candidate for candidate in paths if os.path.isfile(candidate)), None)

values = {}
if path:
    with open(path, encoding="utf-8") as file:
        for line in file:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = [part.strip() for part in line.split("=", 1)]
            values[key] = value

def pick(keys, default):
    for key in keys:
        value = values.get(key)
        if value:
            return value
    return default

font_size = pick(("font-size", "font.size", "font_size", "terminal-font-size", "terminal.font-size", "terminal_font_size"), font_size)
font_weight = pick(("font-weight", "font.weight", "font_weight", "terminal-font-weight", "terminal.font-weight", "terminal_font_weight"), font_weight)
letter_spacing = pick(("letter-spacing", "letter.spacing", "letter_spacing", "font-letter-spacing", "font.letter-spacing", "font_letter_spacing", "terminal-letter-spacing", "terminal.letter-spacing", "terminal_letter_spacing", "terminal-character-spacing", "terminal.character-spacing", "terminal_character_spacing"), letter_spacing)
line_height = pick(("line-height", "line.height", "line_height", "terminal-line-height", "terminal.line-height", "terminal_line_height"), line_height)

print(f"FONT_SIZE={shlex.quote(font_size)}")
print(f"FONT_WEIGHT={shlex.quote(font_weight)}")
print(f"LETTER_SPACING={shlex.quote(letter_spacing)}")
print(f"LINE_HEIGHT={shlex.quote(line_height)}")
PY
}

eval "$(termux_font_defaults)"
CLIPBOARD_BRIDGE="$(normalize_yes_no TERMUX_TTYD_PWA_CLIPBOARD_BRIDGE "$CLIPBOARD_BRIDGE")"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --host)
      require_value "$@"
      HOST="$2"
      shift 2
      ;;
    --app-port)
      require_value "$@"
      APP_PORT="$2"
      shift 2
      ;;
    --ttyd-port)
      require_value "$@"
      TTYD_PORT="$2"
      shift 2
      ;;
    --clipboard-bridge)
      require_value "$@"
      CLIPBOARD_BRIDGE="$(normalize_yes_no "$1" "$2")"
      shift 2
      ;;
    --no-clipboard-bridge)
      CLIPBOARD_BRIDGE="no"
      shift
      ;;
    --tmux-session)
      require_value "$@"
      TMUX_SESSION="$2"
      shift 2
      ;;
    --native-tmux-conf)
      require_value "$@"
      NATIVE_TMUX_CONF="$2"
      shift 2
      ;;
    --font-style)
      require_value "$@"
      FONT_STYLE="$2"
      if ! FONT_FAMILY="$(font_family_for_style "$FONT_STYLE")"; then
        printf 'Unknown font style: %s\n' "$FONT_STYLE" >&2
        printf 'Available styles: termux\n' >&2
        exit 2
      fi
      shift 2
      ;;
    --copy-termux-font)
      require_value "$@"
      COPY_TERMUX_FONT="$(normalize_yes_no "$1" "$2")"
      shift 2
      ;;
    --android-font-family)
      require_value "$@"
      ANDROID_FONT_FAMILY="$2"
      shift 2
      ;;
    --font-size)
      require_value "$@"
      FONT_SIZE="$2"
      shift 2
      ;;
    --font-weight)
      require_value "$@"
      FONT_WEIGHT="$2"
      shift 2
      ;;
    --letter-spacing)
      require_value "$@"
      LETTER_SPACING="$2"
      shift 2
      ;;
    --line-height)
      require_value "$@"
      LINE_HEIGHT="$2"
      shift 2
      ;;
    --terminal-padding|--padding)
      require_value "$@"
      TERMINAL_PADDING="$2"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --)
      shift
      if [ "$#" -gt 0 ]; then
        COMMAND=("$@")
      fi
      break
      ;;
    *)
      COMMAND=("$@")
      break
      ;;
  esac
done

if [ ! -d "$APP_DIR/public" ]; then
  printf 'PWA files were not found at %s/public.\n' "$APP_DIR" >&2
  exit 1
fi

if ! command -v ttyd >/dev/null 2>&1; then
  printf 'ttyd is not installed or is not on PATH.\n' >&2
  exit 1
fi

if ! command -v python3 >/dev/null 2>&1; then
  printf 'python3 is required to serve the PWA files.\n' >&2
  exit 1
fi

if [ -n "$TMUX_SESSION" ] && ! command -v tmux >/dev/null 2>&1; then
  printf 'tmux is required when --tmux-session is used.\n' >&2
  exit 1
fi

case "$HOST" in
  127.0.0.1|localhost|::1)
    ;;
  *)
    printf 'WARNING: --host %s exposes a writable ttyd terminal without authentication.\n' "$HOST" >&2
    printf 'Anyone on the reachable network may be able to control this shell. Use only on trusted networks.\n' >&2
    ;;
esac

ensure_server_ports_available

TERMINAL_THEME="$(termux_theme)"
TERMUX_CONFIGURED_FONT_FILE="$(termux_font_file || true)"

if [ "$COPY_TERMUX_FONT" = "no" ]; then
  FONT_STYLE="android"
  FONT_FAMILY="$ANDROID_FONT_FAMILY"
else
  FONT_STYLE="termux"
  FONT_FAMILY='"TermuxTtydPwaFont", monospace'
fi

cleanup() {
  if [ -n "${CLIPBOARD_BRIDGE_PID:-}" ]; then
    kill "$CLIPBOARD_BRIDGE_PID" 2>/dev/null || true
    wait "$CLIPBOARD_BRIDGE_PID" 2>/dev/null || true
  fi
  if [ -n "${TTYD_PID:-}" ]; then kill "$TTYD_PID" 2>/dev/null || true; fi
  if [ -n "${PUBLIC_DIR:-}" ] && [ -d "$PUBLIC_DIR" ]; then rm -rf "$PUBLIC_DIR"; fi
}
trap cleanup EXIT INT TERM

PUBLIC_DIR="$(mktemp -d "${TMPDIR:-/tmp}/termux-ttyd-pwa.XXXXXX")"
cp -R "$APP_DIR/public/." "$PUBLIC_DIR/"
TTYD_INDEX_FILE="$PUBLIC_DIR/ttyd-index.html"
TTYD_INDEX_OPTION=(--index "$TTYD_INDEX_FILE")

if [ "$COPY_TERMUX_FONT" = "yes" ] && [ -n "$TERMUX_CONFIGURED_FONT_FILE" ]; then
  create_ttyd_index "$TTYD_INDEX_FILE" "$TERMUX_CONFIGURED_FONT_FILE" "http://$CLIPBOARD_BRIDGE_HOST:$CLIPBOARD_BRIDGE_PORT"
elif [ "$COPY_TERMUX_FONT" = "yes" ]; then
  printf 'Termux font file was not found. Set ~/.termux/font.ttf or TERMUX_FONT_FILE.\n' >&2
  exit 1
else
  create_ttyd_index "$TTYD_INDEX_FILE" "" "http://$CLIPBOARD_BRIDGE_HOST:$CLIPBOARD_BRIDGE_PORT"
fi

python3 - "$PUBLIC_DIR/config.js" "$FONT_STYLE" "$FONT_FAMILY" "$TERMINAL_PADDING" <<'PY'
import json
import sys

path, font_style, font_family, terminal_padding = sys.argv[1:]
config = {
    "fontStyle": font_style,
    "fontFamily": font_family,
    "terminalPadding": terminal_padding,
}
with open(path, "w", encoding="utf-8") as file:
    file.write("window.TERMUX_TTYD_PWA_CONFIG = ")
    json.dump(config, file, ensure_ascii=True)
    file.write(";\n")
PY

if [ "$CLIPBOARD_BRIDGE" = "yes" ]; then
  start_clipboard_bridge
fi

if [ -n "$TMUX_SESSION" ]; then
  TMUX_WRAPPED_COMMAND=(env -u TMUX "${COMMAND[@]}")
  printf -v TMUX_COMMAND '%q ' "${TMUX_WRAPPED_COMMAND[@]}"
  ensure_native_tmux_config "$NATIVE_TMUX_CONF"
  COMMAND=(
    sh -c '
      tmux -L "$1" -f "$2" has-session -t "$3" 2>/dev/null || tmux -L "$1" -f "$2" new-session -d -s "$3" "$4" || exit 1
      tmux -L "$1" -f "$2" source-file "$2" || exit 1
      exec tmux -L "$1" -f "$2" attach-session -t "$3"
    ' sh "$NATIVE_TMUX_SOCKET" "$NATIVE_TMUX_CONF" "$TMUX_SESSION" "$TMUX_COMMAND"
  )
fi

ttyd \
  --writable \
  --interface "$HOST" \
  --port "$TTYD_PORT" \
  "${TTYD_INDEX_OPTION[@]}" \
  --client-option "fontFamily=$FONT_FAMILY" \
  --client-option "fontSize=$FONT_SIZE" \
  --client-option "fontWeight=$FONT_WEIGHT" \
  --client-option "letterSpacing=$LETTER_SPACING" \
  --client-option "lineHeight=$LINE_HEIGHT" \
  --client-option "theme=$TERMINAL_THEME" \
  "${COMMAND[@]}" &
TTYD_PID="$!"

printf 'ttyd: http://%s:%s/\n' "$HOST" "$TTYD_PORT"
printf 'PWA:  http://%s:%s/\n' "$HOST" "$APP_PORT"
if [ "$CLIPBOARD_BRIDGE" = "yes" ]; then
  printf 'Clipboard bridge: http://%s:%s/\n' "$CLIPBOARD_BRIDGE_HOST" "$CLIPBOARD_BRIDGE_PORT"
else
  printf 'Clipboard bridge: disabled\n'
fi
printf 'Termux font copy: %s\n' "$COPY_TERMUX_FONT"
printf 'Font: style=%s family=%s size=%s weight=%s letter-spacing=%s line-height=%s\n' "$FONT_STYLE" "$FONT_FAMILY" "$FONT_SIZE" "$FONT_WEIGHT" "$LETTER_SPACING" "$LINE_HEIGHT"
printf 'Terminal padding: %s\n' "$TERMINAL_PADDING"
if [ -n "$TMUX_SESSION" ]; then
  printf 'Native tmux conf: %s\n' "$NATIVE_TMUX_CONF"
fi

python3 -m http.server "$APP_PORT" --bind "$HOST" --directory "$PUBLIC_DIR"
